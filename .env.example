# OpenAI API 키 (Realtime 영어 회화용) — 서버에서만 사용됩니다.
# https://platform.openai.com/api-keys 에서 발급 후 아래에 붙여넣고
# 이 파일을 복사해 .env 로 저장하세요.  (.env 는 절대 커밋하지 마세요)
OPENAI_API_KEY=sk-...

# Supabase Auth — 서버에서만 사용됩니다.
# 대시보드 → Project Settings → API 의 Project URL 과 publishable 키
# 아래 이름 또는 SUPABASE_DB_UR / SUPABASE_DB_PUBLIC_KEY 도 인식합니다.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
