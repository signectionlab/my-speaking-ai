# my-speaking-ai와 같은 Supabase 프로젝트.
# Project Settings → API 의 Project URL 과 publishable 키.
# SUPABASE_DB_UR / SUPABASE_DB_PUBLIC_KEY 이름도 인식합니다.
# 이 파일을 복사해 .env 로 저장하세요. .env 는 커밋하지 마세요.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# service role 키는 이 앱에서 쓰지 않습니다.
# PUBLIC_ 로 시작하는 변수에 넣으면 브라우저에 노출되므로 두지 마세요.
